# ════════════════════════════════════════════════════════════════════════════════
# PyPI Configuration Template
# ════════════════════════════════════════════════════════════════════════════════
#
# Copy this file to ~/.pypirc and fill in your credentials.
# NEVER commit your actual .pypirc file!
#
# For API tokens (recommended):
#   1. Go to https://pypi.org/manage/account/token/
#   2. Create a token with scope "Entire account" or "Project: arnold-kan"
#   3. Use __token__ as username and the token as password
#
# ════════════════════════════════════════════════════════════════════════════════

[distutils]
index-servers =
    pypi
    testpypi

[pypi]
repository = https://upload.pypi.org/legacy/
username = __token__
password = pypi-YOUR_TOKEN_HERE

[testpypi]
repository = https://test.pypi.org/legacy/
username = __token__
password = pypi-YOUR_TEST_TOKEN_HERE
